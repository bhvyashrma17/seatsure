# ---------------------------------------------------------------
# SeatSure shared environment (used by /db and /server).
# Copy to .env and adjust. Never commit the real .env.
# ---------------------------------------------------------------

# PostgreSQL 18 (local). Homebrew installs: YOUR_USERNAME = your macOS username (run `whoami`), no password.
# Windows / password installs: postgresql://postgres:YOUR_PASSWORD@localhost:5432/seatsure_dev
DATABASE_URL="postgresql://YOUR_USERNAME@localhost:5432/seatsure_dev?schema=public"
# Separate database used by the automated tests (it is wiped between test files).
DATABASE_URL_TEST="postgresql://YOUR_USERNAME@localhost:5432/seatsure_test?schema=public"
# Connection pool size for the API process ([ADB M2.12]).
DB_POOL_MAX=10

# MongoDB (activity feed + notifications). Leave empty in development to use the
# built-in in-memory MongoDB (data is rebuilt from PostgreSQL on every start).
# Atlas example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/seatsure
MONGODB_URI=""

# API server
PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV=development
